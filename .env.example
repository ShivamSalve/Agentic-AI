# ---- Copy this file to ".env". Ollama runs locally and needs no API key. ----

# Set to 1 to test the interface with fake AI replies (not real answers)
MOCK_MODE=0

# ---------- Recommended: Local Ollama ----------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# No LLM_API_KEY required for Ollama.

# ---------- Optional: Groq / Gemini OpenAI-compatible API ----------
# Set LLM_PROVIDER to a value other than "ollama" and provide your API key.
# LLM_PROVIDER=groq
# LLM_API_KEY=paste_your_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Gemini: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
