# ---- Copy this file to ".env" and fill in your key ----

# Set to 1 to test the app WITHOUT any API key (fake AI replies, for demo only)
MOCK_MODE=0

# ---------- Option A: Groq (free tier) -> https://console.groq.com/keys ----------
LLM_API_KEY=paste_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ---------- Option B: Google Gemini (free tier) -> https://aistudio.google.com/apikey ----------
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
